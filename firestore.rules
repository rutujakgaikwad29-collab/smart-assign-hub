rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }
    
    function isTeacher() {
      return isAuthenticated() && getUserData().role == 'teacher';
    }
    
    function isStudent() {
      return isAuthenticated() && getUserData().role == 'student';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isAuthenticated(); // Needed to check roles for rules
      allow create: if isAuthenticated(); // Initially created on signup
      allow update, delete: if isOwner(userId) || isAdmin();
    }

    // --- Students Collection ---
    match /students/{studentId} {
      // Admins and Teachers need to see students for management and enrollment tracking
      allow read: if isAdmin() || isTeacher() || isOwner(studentId);
      allow create: if isAuthenticated(); 
      allow update, delete: if isOwner(studentId) || isAdmin();
    }

    // --- Teachers Collection ---
    match /teachers/{teacherId} {
      // Admins need to see teachers; Students might need to see teacher names for assignments
      allow read: if isAdmin() || isTeacher() || isStudent();
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(teacherId) || isAdmin();
    }
    
    // --- Admins Collection ---
    match /admins/{adminId} {
      allow read: if isAdmin() || isOwner(adminId);
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(adminId) || isAdmin();
    }

    // --- Assignments Collection ---
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isTeacher() && resource.data.teacherUid == request.auth.uid) ||
        (isStudent() && (
          // Exact match: student's classId matches assignment's classId
          resource.data.classId == getUserData().classId ||
          // Prefix match: assignment classId is a prefix of student's classId (handles batch suffix)
          // e.g. assignment classId = "CS-2-A", student classId = "CS-2-A-B1"
          getUserData().classId.matches(resource.data.classId + '.*')
        ))
      );
      allow create: if isTeacher() || isAdmin();
      allow update, delete: if isAuthenticated() && (resource.data.teacherUid == request.auth.uid || isAdmin());
    }

    // --- Submissions Collection ---
    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isStudent() && resource.data.studentUid == request.auth.uid) ||
        isTeacher()
      );
      allow create: if isStudent() && request.resource.data.studentUid == request.auth.uid;
      // Teachers can update for grading, students can update for resubmission
      allow update: if isAuthenticated() && (
        resource.data.studentUid == request.auth.uid || 
        isTeacher() || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // --- Late Requests Collection ---
    match /lateRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isStudent() && request.resource.data.studentUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.studentUid == request.auth.uid || 
        isTeacher() || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // --- Notifications Collection ---
    match /notifications/{notificationId} {
      // Users can only read and mark their own notifications as read
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Teachers and admins can send notifications
      allow create: if isTeacher() || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
